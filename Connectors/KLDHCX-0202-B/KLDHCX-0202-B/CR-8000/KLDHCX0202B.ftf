(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad c486
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 243000
            (pt 0 0)
          )
        )
      )
      (pad c406.5
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 203250
            (pt 0 0)
          )
        )
      )
      (pad c370
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 185000
            (pt 0 0)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack c486h324
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 162000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c486))
          (noconnect (pad c486))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c486))
          (noconnect (pad c486))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c486))
          (noconnect (pad c486))
        )
        (padSet (footLayer Inner)
          (clearance (pad c486))
          (connect (pad c486))
          (noconnect (pad c486))
        )
        (padSet (footLayer Bottom)
          (connect (pad c486))
          (noconnect (pad c486))
        )
      )
      (padstack c406.5h271
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 135500
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c406.5))
          (noconnect (pad c406.5))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c406.5))
          (noconnect (pad c406.5))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c406.5))
          (noconnect (pad c406.5))
        )
        (padSet (footLayer Inner)
          (clearance (pad c406.5))
          (connect (pad c406.5))
          (noconnect (pad c406.5))
        )
        (padSet (footLayer Bottom)
          (connect (pad c406.5))
          (noconnect (pad c406.5))
        )
