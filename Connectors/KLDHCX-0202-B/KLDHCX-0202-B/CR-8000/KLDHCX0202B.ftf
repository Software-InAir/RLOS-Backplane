      (padstack c370h246
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 123000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c370))
          (noconnect (pad c370))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c370))
          (noconnect (pad c370))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c370))
          (noconnect (pad c370))
        )
        (padSet (footLayer Inner)
          (clearance (pad c370))
          (connect (pad c370))
          (noconnect (pad c370))
        )
        (padSet (footLayer Bottom)
          (connect (pad c370))
          (noconnect (pad c370))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "KLDHCX0202B"
        (polarity YES)
        (panelUse NO)
        (heelprint
